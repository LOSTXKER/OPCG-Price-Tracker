{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "meecard-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "meecard-start-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "meecard-start-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3002,
      "autoPort": true
    }
  ]
}
