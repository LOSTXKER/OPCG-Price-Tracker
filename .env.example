# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
# DATABASE_URL = Transaction pooler (port 6543) — for app runtime
# DIRECT_URL   = Direct connection (port 5432)  — for Prisma migrations
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Cron Security
CRON_SECRET=your-cron-secret-here

# Exchange Rate API (https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Google Gemini API (https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key

# Email (Resend — https://resend.com/)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Kuma Tracker <noreply@kumatracker.com>"

# Stripe (https://stripe.com/)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_PLUS_YEARLY_PRICE_ID=price_...

# LINE Login & Messaging
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
NEXT_PUBLIC_LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id

# App URL (used for SEO, emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev: bypass all auth checks (never use in production)
# NEXT_PUBLIC_BYPASS_AUTH=true

# Scraper
SCRAPE_VERBOSE=false

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=meecard
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
