generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// GAME (Multi-TCG)
// ============================================================

model Game {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  nameEn    String?
  logoUrl   String?
  isActive  Boolean   @default(true)
  sets      CardSet[]
  createdAt DateTime  @default(now())
}

// ============================================================
// CARD DATA
// ============================================================

model CardSet {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  nameEn       String?
  nameTh       String?
  type         SetType
  gameId       Int?
  game         Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  releaseDate  DateTime?
  cardCount    Int           @default(0)
  packsPerBox  Int?
  cardsPerPack Int?
  boxImageUrl  String?
  msrpJpy      Int?
  cards        Card[]
  dropRates    SetDropRate[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([gameId])
}

enum SetType {
  BOOSTER
  EXTRA_BOOSTER
  STARTER
  PROMO
  OTHER
}

model Card {
  id              Int              @id @default(autoincrement())
  cardCode        String           @unique
  baseCode        String?
  parallelIndex   Int?
  yuyuteiId       String?
  yuyuteiUrl      String?
  setId           Int
  set             CardSet          @relation(fields: [setId], references: [id], onDelete: Restrict)
  nameJp          String
  nameEn          String?
  nameTh          String?
  rarity          String
  cardType        CardType
  color           String
  colorEn         String?
  cost            Int?
  power           Int?
  counter         Int?
  life            Int?
  attribute       String?
  trait           String?
  artist          String?
  effectJp        String?
  effectEn        String?
  effectTh        String?
  triggerJp       String?
  triggerEn       String?
  imageUrl        String?
  isParallel      Boolean          @default(false)
  viewCount       Int              @default(0)
  priceChange24h  Float?
  priceChange7d   Float?
  priceChange30d  Float?
  latestPriceJpy  Int?
  latestPriceThb  Float?
  prices          CardPrice[]
  portfolioItems       PortfolioItem[]
  portfolioTransactions PortfolioTransaction[]
  watchlistItems       WatchlistItem[]
  priceAlerts     PriceAlert[]
  listings        Listing[]
  communityPrices CommunityPrice[]
  pricePredictions    PricePrediction[]
  deckLeaders     Deck[]           @relation("DeckLeader")
  deckCards           DeckCard[]
  productCards        ProductCard[]
  yuyuteiMappings     YuyuteiMapping[]
  snkrdunkMappings    SnkrdunkMapping[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([setId])
  @@index([baseCode])
  @@index([yuyuteiId])
  @@index([rarity])
  @@index([cardType])
  @@index([color])
  @@index([nameJp])
  @@index([viewCount(sort: Desc)])
  @@index([priceChange24h(sort: Desc)])
  @@index([priceChange7d(sort: Desc)])
}

enum CardType {
  CHARACTER
  EVENT
  STAGE
  LEADER
  DON
}

// ============================================================
// PRICE DATA (Multi-source)
// ============================================================

model CardPrice {
  id             Int         @id @default(autoincrement())
  cardId         Int
  card           Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source         PriceSource @default(YUYUTEI)
  type           PriceType   @default(SELL)
  priceJpy       Int?
  priceThb       Float?
  priceUsd       Float?
  priceEur       Float?
  inStock        Boolean     @default(true)
  gradeCondition String?
  scrapedAt      DateTime    @default(now())

  @@index([cardId, source, scrapedAt(sort: Desc)])
  @@index([cardId, source, gradeCondition, scrapedAt(sort: Desc)])
  @@index([scrapedAt])
}

enum PriceSource {
  YUYUTEI
  SNKRDUNK
  EBAY_JP
  MERCARI_JP
  PORTFOLIO
  MARKETPLACE
  CARDMARKET
  TCGPLAYER
}

enum PriceType {
  SELL
  BUY
  SOLD
  LISTING
}

model SetDropRate {
  id          Int     @id @default(autoincrement())
  setId       Int
  set         CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  rarity      String
  avgPerBox   Float?
  ratePerPack Float?

  @@unique([setId, rarity])
  @@index([setId])
}

// ============================================================
// PRODUCT (physical boxes/packs that contain cards)
// ============================================================

model Product {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  nameEn      String?
  nameTh      String?
  type        SetType
  releaseDate DateTime?
  cards       ProductCard[]
  createdAt   DateTime      @default(now())
}

model ProductCard {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cardId    Int
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([productId, cardId])
  @@index([productId])
  @@index([cardId])
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  fromCur   String   @default("JPY")
  toCur     String   @default("THB")
  rate      Float
  fetchedAt DateTime @default(now())

  @@index([fetchedAt(sort: Desc)])
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                  String           @id @default(cuid())
  supabaseId          String           @unique
  email               String           @unique
  displayName         String?
  avatarUrl           String?
  bio                 String?          @db.VarChar(500)
  tier                UserTier         @default(FREE)
  tierExpiresAt       DateTime?
  trialStartedAt      DateTime?
  trialUsed           Boolean          @default(false)
  stripeCustomerId    String?          @unique
  stripeSubscriptionId String?
  honeyPoints         Int              @default(0)
  lastCheckinAt       DateTime?
  checkinStreak       Int              @default(0)
  lineUserId          String?          @unique
  isAdmin             Boolean          @default(false)
  sellerRating        Float?
  sellerReviewCount   Int              @default(0)
  emailAlerts         Boolean          @default(true)
  lineAlerts          Boolean          @default(false)
  weeklyDigest        Boolean          @default(true)
  notifyPriceEmail    Boolean          @default(true)
  notifyPriceWeb      Boolean          @default(true)
  notifyPriceLine     Boolean          @default(false)
  notifyMarketEmail   Boolean          @default(true)
  notifyMarketWeb     Boolean          @default(true)
  notifyMarketLine    Boolean          @default(false)
  notifyHoneyEmail    Boolean          @default(true)
  notifyHoneyWeb      Boolean          @default(true)
  notifyHoneyLine     Boolean          @default(false)
  notifyDigestEmail   Boolean          @default(true)
  notifyDigestWeb     Boolean          @default(true)
  notifyDigestLine    Boolean          @default(false)
  profileVisibility   String           @default("public")
  showCollection      Boolean          @default(true)
  showListings        Boolean          @default(true)
  showDecks           Boolean          @default(true)
  showStats           Boolean          @default(true)
  showWatchlist       Boolean          @default(true)
  hidePortfolioPrices Boolean          @default(false)
  hidePortfolioQty    Boolean          @default(false)
  profileSummaryOnly  Boolean          @default(false)
  handle              String?          @unique
  socialLine          String?          @db.VarChar(60)
  socialIg            String?          @db.VarChar(60)
  socialTwitter       String?          @db.VarChar(60)
  socialFacebook      String?          @db.VarChar(120)
  savedByUsers        SavedSeller[]    @relation("SellerSavedBy")
  savedSellers        SavedSeller[]    @relation("UserSavedSellers")
  lastDigestAt        DateTime?
  portfolios          Portfolio[]
  watchlistItems      WatchlistItem[]
  priceAlerts         PriceAlert[]
  listings            Listing[]
  sentMessages        Message[]        @relation("SentMessages")
  receivedMessages    Message[]        @relation("ReceivedMessages")
  offersMade          Offer[]          @relation("OffersMade")
  offersReceived      Offer[]          @relation("OffersReceived")
  ordersBought        Order[]          @relation("OrdersBought")
  ordersSold          Order[]          @relation("OrdersSold")
  reviewsGiven        Review[]         @relation("ReviewsGiven")
  reviewsReceived     Review[]         @relation("ReviewsReceived")
  savedListings       SavedListing[]
  communityPrices     CommunityPrice[]
  honeyTransactions   HoneyTransaction[]
  honeyLifetimeEarned   Int              @default(0)
  profileFrame          String?
  onboardingCompleted   Boolean          @default(false)
  extraPriceAlertSlots  Int              @default(0)
  csvExportCredits      Int              @default(0)
  ticketBalance         Int              @default(0)
  referralCode          String?          @unique
  badges              UserBadge[]
  dailyMissions       DailyMission[]
  monthlyMissions     MonthlyMission[]
  referralLinks       ReferralLink[]
  pricePredictions    PricePrediction[]
  achievements        UserAchievement[]
  raffleTickets       RaffleTicket[]
  decks               Deck[]
  yuyuteiActions      YuyuteiMapping[]
  snkrdunkActions     SnkrdunkMapping[]
  blogPosts           BlogPost[]
  loginHistory        LoginHistory[]
  savedFilters        SavedFilter[]
  notifications       Notification[]
  shippingAddresses   ShippingAddress[]
  cancelReasons       CancelReason[]
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([supabaseId])
  @@index([tier])
  @@index([stripeCustomerId])
  @@index([lineUserId])
  @@index([deletedAt])
  @@index([handle])
}

// ============================================================
// HONEY SYSTEM (Engagement Points)
// ============================================================

model HoneyTransaction {
  id        Int             @id @default(autoincrement())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      HoneyActionType
  reason    String
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt])
}

enum HoneyActionType {
  CHECKIN
  MARKETPLACE_SELL
  REVIEW
  REFERRAL
  REDEEM
  ADMIN_GRANT
  TRIAL_BONUS
  EXPIRED
  DAILY_MISSION
  PRICE_PREDICTION
  DECK_SHARE
  COMMUNITY_PRICE
  ONBOARDING
  ACHIEVEMENT
  RAFFLE_TICKET
  RAFFLE_WIN
  LEVEL_UP
  WEEKLY_BONUS
  MONTHLY_MISSION
  LEADERBOARD_REWARD
  // Deprecated — kept for historical transaction data
  PORTFOLIO_ADD
  GIFT_SEND
  GIFT_RECEIVE
  LUCKY_DRAW
  FIRST_PURCHASE
  SHARE
  AFFILIATE
}

model HoneyShopItem {
  id          Int          @id @default(autoincrement())
  name        String
  nameEn      String?
  nameTh      String?
  description String?
  cost        Int
  type        ShopItemType
  value       Json?
  isActive    Boolean      @default(true)
  stock       Int?
  createdAt   DateTime     @default(now())

  @@index([isActive])
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?
  nameTh    String?
  imageUrl  String?
  grantedAt DateTime @default(now())

  @@index([userId])
}

model DailyMission {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String
  tasks         Json     @default("[]") // [{ id, done, reward, claimed }]
  progress      Int      @default(0)
  completed     Boolean  @default(false)
  perfectDay    Boolean  @default(false)
  bonusClaimed  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model PricePrediction {
  id                Int      @id @default(autoincrement())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId            Int
  card              Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  direction         String
  priceAtPrediction Int
  weekStart         String
  resolved          Boolean  @default(false)
  correct           Boolean?
  rewarded          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, cardId, weekStart])
  @@index([resolved])
}

model Achievement {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  name          String
  nameEn        String?
  nameTh        String?
  description   String?
  criteria      Json
  honeyReward   Int
  badgeImageUrl String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  users         UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId Int
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model MonthlyRaffle {
  id             Int            @id @default(autoincrement())
  month          String         // "2026-04"
  slug           String         @default("default")
  title          String
  titleEn        String?
  titleTh        String?
  description    String?
  imageUrl       String?
  color          String?
  prizes         Json           // [{ rank, name, imageUrl?, honeyBonus? }]
  ticketCost     Int            @default(50)
  maxTickets     Int            @default(5)
  freeThreshold  Int            @default(7) // streak days for free ticket
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  drawnAt        DateTime?
  winnerId       String?
  winnerTicketId Int?
  tickets        RaffleTicket[]
  createdAt      DateTime       @default(now())

  @@unique([month, slug])
  @@index([isActive, month])
}

model RaffleTicket {
  id        Int            @id @default(autoincrement())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffleId  Int
  raffle    MonthlyRaffle  @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  isFree    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([raffleId, userId])
  @@index([userId])
}

model MonthlyMission {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // "2026-04"
  tasks     Json     // [{ id, done, claimed, progress, target }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

// ── Mission Templates & Scheduling (Admin-configurable) ──

enum MissionCategory {
  DAILY
  MONTHLY
  SPECIAL
}

enum MissionTrackType {
  AUTO_PATH
  MANUAL
  ACTION_COUNT
}

enum MissionSlotType {
  CORE
  DAY_OF_WEEK
  RANDOM_POOL
  FIXED_DATE
  SEQUENTIAL
}

enum MissionBonusRequirement {
  ALL_COMPLETE
  COUNT_COMPLETE
  STREAK_DAYS
}

model MissionTemplate {
  id            Int                   @id @default(autoincrement())
  code          String                @unique
  name          String
  nameEn        String?
  nameTh        String?
  description   String?
  descriptionEn String?
  descriptionTh String?
  icon          String                @default("Circle")
  category      MissionCategory       @default(DAILY)
  trackType     MissionTrackType      @default(AUTO_PATH)
  conditions    Json                  // { type, paths?, action?, pathPattern? }
  rewards       Json                  // { honey, tickets?, badgeCode?, ... }
  target        Int                   @default(1)
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scheduleRules MissionScheduleRule[]

  @@index([category, isActive])
}

model MissionScheduleRule {
  id            Int             @id @default(autoincrement())
  templateId    Int
  template      MissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slotType      MissionSlotType
  dayOfWeek     Int?
  specificDates Json?
  poolGroup     String?
  poolPickCount Int?
  startDate     DateTime?
  endDate       DateTime?
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@index([slotType, isActive])
  @@index([templateId])
}

model MissionBonusRule {
  id               Int                     @id @default(autoincrement())
  name             String
  nameEn           String?
  nameTh           String?
  category         MissionCategory
  requirement      MissionBonusRequirement
  requirementValue Int                     @default(1)
  rewards          Json
  isActive         Boolean                 @default(true)
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())

  @@index([category, isActive])
}

model SeasonalEvent {
  id              Int      @id @default(autoincrement())
  name            String
  nameEn          String?
  nameTh          String?
  description     String?
  startDate       DateTime
  endDate         DateTime
  honeyMultiplier Float    @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model ReferralLink {
  id        Int             @id @default(autoincrement())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String          @unique
  clicks    Int             @default(0)
  createdAt DateTime        @default(now())
  referralClicks ReferralClick[]

  @@index([userId])
  @@index([code])
}

model ReferralClick {
  id        Int          @id @default(autoincrement())
  linkId    Int
  link      ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  visitorIp String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([linkId, createdAt])
}

enum ShopItemType {
  TRIAL_PRO
  TRIAL_PRO_PLUS
  BADGE
  CUSTOM
  PROFILE_FRAME
  PRICE_ALERT_SLOT
  CSV_EXPORT_PASS
  RAFFLE_TICKET
}

enum UserTier {
  FREE
  PRO
  PRO_PLUS
  LIFETIME_PRO
  LIFETIME_PRO_PLUS
}

// ============================================================
// PORTFOLIO
// ============================================================

model Portfolio {
  id           Int                    @id @default(autoincrement())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String                 @default("Default")
  items        PortfolioItem[]
  snapshots    PortfolioSnapshot[]
  transactions PortfolioTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId])
}

model PortfolioSnapshot {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  totalJpy    Int
  totalThb    Float?
  totalCost   Int
  pnl         Int
  cardCount   Int
  snapshotAt  DateTime @default(now())

  @@index([portfolioId, snapshotAt(sort: Desc)])
}

model PortfolioItem {
  id            Int           @id @default(autoincrement())
  portfolioId   Int
  portfolio     Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  cardId        Int
  card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity      Int           @default(1)
  purchasePrice Int?
  condition     CardCondition @default(NM)
  notes         String?
  isPrivate     Boolean       @default(false)
  addedAt       DateTime      @default(now())

  @@unique([portfolioId, cardId, condition])
  @@index([portfolioId])
  @@index([cardId])
  @@index([portfolioId, isPrivate])
}

model PortfolioTransaction {
  id           Int             @id @default(autoincrement())
  portfolioId  Int
  portfolio    Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  cardId       Int
  card         Card            @relation(fields: [cardId], references: [id], onDelete: Restrict)
  type         TransactionType
  quantity     Int
  pricePerUnit Int?
  note         String?
  createdAt    DateTime        @default(now())

  @@index([portfolioId, createdAt(sort: Desc)])
  @@index([cardId])
}

enum TransactionType {
  BUY
  REMOVE
}

enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

// ============================================================
// WATCHLIST & ALERTS
// ============================================================

model WatchlistItem {
  id      Int      @id @default(autoincrement())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId  Int
  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([userId, cardId])
  @@index([userId])
}

model PriceAlert {
  id          Int            @id @default(autoincrement())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId      Int
  card        Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  targetPrice Int
  direction   AlertDirection
  channel     AlertChannel   @default(EMAIL)
  isActive    Boolean        @default(true)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, isActive])
  @@index([cardId, isActive])
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertChannel {
  EMAIL
  LINE
  PUSH
}

// ============================================================
// MARKETPLACE
// ============================================================

model Listing {
  id           Int           @id @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cardId       Int
  card         Card          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  priceJpy     Int
  priceThb     Float?
  condition    CardCondition @default(NM)
  quantity     Int           @default(1)
  description  String?
  photos       String[]
  shipping     String[]
  location     String?
  status       ListingStatus @default(ACTIVE)
  isFeatured   Boolean       @default(false)
  isBoosted    Boolean       @default(false)
  boostedUntil DateTime?
  viewCount    Int           @default(0)
  messages     Message[]
  offers       Offer[]
  orders       Order[]
  savedBy      SavedListing[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([cardId, status])
  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([isFeatured, status])
}

model SavedListing {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// Lets a buyer "save" a seller they like (similar to Etsy's "Favorite shop"
// or following an IG account). Used for quick access to trusted sellers.
model SavedSeller {
  id        Int      @id @default(autoincrement())
  userId    String   // the buyer who saved
  user      User     @relation("UserSavedSellers", fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String   // the seller being saved
  seller    User     @relation("SellerSavedBy", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, sellerId])
  @@index([userId])
  @@index([sellerId])
}

enum ListingStatus {
  ACTIVE
  SOLD
  RESERVED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  COUNTERED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
  ORDER_UPDATE
  SYSTEM
}

model Offer {
  id        Int         @id @default(autoincrement())
  listingId Int
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId   String
  buyer     User        @relation("OffersMade", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId  String
  seller    User        @relation("OffersReceived", fields: [sellerId], references: [id], onDelete: Restrict)
  priceThb  Float
  status    OfferStatus @default(PENDING)
  note      String?
  parentId  Int?
  parent    Offer?      @relation("CounterOffers", fields: [parentId], references: [id], onDelete: SetNull)
  counters  Offer[]     @relation("CounterOffers")
  order     Order?
  messages  Message[]
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId, status])
  @@index([buyerId])
  @@index([sellerId])
}

model Order {
  id                Int              @id @default(autoincrement())
  listingId         Int
  listing           Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offerId           Int?             @unique
  offer             Offer?           @relation(fields: [offerId], references: [id], onDelete: SetNull)
  buyerId           String
  buyer             User             @relation("OrdersBought", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId          String
  seller            User             @relation("OrdersSold", fields: [sellerId], references: [id], onDelete: Restrict)
  priceThb          Float
  status            OrderStatus      @default(AWAITING_PAYMENT)
  shippingMethod    String?
  trackingNumber    String?
  shippingAddressId String?
  shippingAddress   ShippingAddress?  @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  note              String?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  messages          Message[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Message {
  id         Int         @id @default(autoincrement())
  listingId  Int
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  receiverId String
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)
  content    String
  type       MessageType @default(TEXT)
  offerId    Int?
  offer      Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  orderId    Int?
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  metadata   Json?
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([listingId, createdAt])
  @@index([receiverId, isRead])
  @@index([offerId])
  @@index([orderId])
}

model Review {
  id         Int      @id @default(autoincrement())
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)
  listingId  Int?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([reviewerId, revieweeId, listingId])
  @@index([revieweeId])
}

// ============================================================
// COMMUNITY PRICE
// ============================================================

model CommunityPrice {
  id        Int                  @id @default(autoincrement())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    Int
  card      Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  priceThb  Int
  upvotes   Int                  @default(0)
  votes     CommunityPriceVote[]
  createdAt DateTime             @default(now())

  @@index([cardId, createdAt(sort: Desc)])
  @@index([userId, createdAt])
}

model CommunityPriceVote {
  id               Int            @id @default(autoincrement())
  communityPriceId Int
  communityPrice   CommunityPrice @relation(fields: [communityPriceId], references: [id], onDelete: Cascade)
  userId           String
  createdAt        DateTime       @default(now())

  @@unique([communityPriceId, userId])
  @@index([userId])
}

// ============================================================
// DECK CALCULATOR
// ============================================================

model Deck {
  id        Int        @id @default(autoincrement())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  leaderId  Int?
  leader    Card?      @relation("DeckLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  cards     DeckCard[]
  isPublic  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model DeckCard {
  id       Int  @id @default(autoincrement())
  deckId   Int
  deck     Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity Int  @default(1)

  @@unique([deckId, cardId])
  @@index([deckId])
}

// ============================================================
// YUYUTEI MAPPING (AI-assisted card-to-price matching)
// ============================================================

model YuyuteiMapping {
  id            Int       @id @default(autoincrement())
  setCode       String
  yuyuteiId     String
  scrapedCode   String
  scrapedRarity String?
  scrapedName   String
  scrapedImage  String?
  priceJpy      Int
  matchedCardId Int?
  matchedCard   Card?     @relation(fields: [matchedCardId], references: [id], onDelete: SetNull)
  matchMethod   String?
  geminiScore   Float?
  status        String    @default("pending")
  actionBy      String?
  actionByUser  User?     @relation(fields: [actionBy], references: [id], onDelete: SetNull)
  actionAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([setCode, yuyuteiId])
  @@index([status])
  @@index([setCode])
  @@index([matchedCardId])
}

// ============================================================
// SNKRDUNK MAPPING (PSA10 & secondary market price tracking)
// ============================================================

model SnkrdunkMapping {
  id              Int       @id @default(autoincrement())
  snkrdunkId      Int       @unique
  productNumber   String
  scrapedName     String
  thumbnailUrl    String?
  minPriceUsd     Float?
  usedMinPriceUsd Float?
  lastSoldPsa10Usd Float?
  matchedCardId   Int?
  matchedCard     Card?     @relation(fields: [matchedCardId], references: [id], onDelete: SetNull)
  matchMethod     String?
  status          String    @default("pending")
  actionBy        String?
  actionByUser    User?     @relation(fields: [actionBy], references: [id], onDelete: SetNull)
  actionAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([productNumber])
  @@index([matchedCardId])
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  category    BlogCategory
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

enum BlogCategory {
  MARKET_ANALYSIS @map("market-analysis")
  SET_REVIEW      @map("set-review")
  TIPS            @map("tips")
  NEWS            @map("news")
}

// ============================================================
// LOGIN HISTORY (Gap 3)
// ============================================================

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================
// SAVED FILTERS (Gap 4)
// ============================================================

model SavedFilter {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// SYSTEM CONFIG (Gap 8)
// ============================================================

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ============================================================
// AUDIT LOG (Gap 9)
// ============================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entity, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================
// IN-APP NOTIFICATIONS (Gap 10)
// ============================================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================
// CANCEL REASONS (Subscription churn analytics)
// ============================================================

model CancelReason {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// SHIPPING ADDRESSES
// ============================================================

model ShippingAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String?
  addressLine String
  district    String?
  province    String
  postalCode  String
  country     String   @default("TH")
  isDefault   Boolean  @default(false)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
